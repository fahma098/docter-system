# ====================================================================
# Doctor Availability & Scheduling System - Environment Variables
# Copy this file to .env or set environment variables in your system
# ====================================================================

# Spring Server Port
SERVER_PORT=8080

# MySQL Database Settings
DB_URL=jdbc:mysql://localhost:3306/doctor_scheduling_system?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Active Spring Profile (mysql or h2 for zero-setup offline evaluation)
SPRING_PROFILES_ACTIVE=mysql

# Clinic Identity & Receipt Settings
CLINIC_NAME=Aura Health & Medical Specialist Center
CLINIC_PHONE=+1 (800) 555-0199
CLINIC_EMAIL=appointments@aurahealth.org
CLINIC_ADDRESS=450 Healthcare Blvd, Suite 800, Metro City
